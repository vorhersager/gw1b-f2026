# ============================================================================
#  GW1B cluster configuration — THE ONE FILE THE INSTRUCTOR EDITS.
#  Sourced by activate.sh, bin/gw1b*, slurm/*.sbatch and env/build_*.sh.
#  Everything marked VERIFY is filled in by `gw1b-admin init` + `gw1b-admin discover` (or by hand).
# ============================================================================

# --- where things live ------------------------------------------------------
# Persistent group storage (NOT purged; keep the environment, tokenizer, code, released models here).
# On Pegasus group storage is /<SCHOOL>/groups/<group>, e.g. /SEAS/groups/gw1b            VERIFY
export GW1B_GROUP="${GW1B_GROUP:-/SEAS/groups/gw1b}"
# Fast scratch (Lustre; purged monthly on Pegasus — datasets, checkpoints, HF cache live here) VERIFY
export GW1B_SCRATCH="${GW1B_SCRATCH:-/lustre/groups/gw1b}"
# This repository (read-only for students)
export GW1B_HOME="${GW1B_HOME:-$GW1B_GROUP/gw1b-f2026}"
# Unix group of the class (all students are members; owns the group dir)                       VERIFY
export GW1B_UNIX_GROUP="${GW1B_UNIX_GROUP:-gw1b-class}"

# --- runtime -----------------------------------------------------------------
export GW1B_ENV_VERSION="2026.09"
export GW1B_RUNTIME="${GW1B_RUNTIME:-auto}"                 # auto | sif | venv
export GW1B_SIF="${GW1B_SIF:-$GW1B_GROUP/sif/gw1b.sif}"     # built by env/build_sif.sh
export GW1B_VENV="${GW1B_VENV:-$GW1B_GROUP/venv}"            # built by env/build_venv.sh (fallback)
export GW1B_APPTAINER_MODULE="${GW1B_APPTAINER_MODULE:-apptainer}"   # `module load` name if needed   VERIFY

# --- Slurm ---------------------------------------------------------------------
export GW1B_ACCOUNT="${GW1B_ACCOUNT:-}"               # e.g. gw1b-class if sbatch requires -A          VERIFY
export GW1B_QOS="${GW1B_QOS:-}"                        # leave empty unless HPC staff gave you a QOS
export GW1B_GRES="${GW1B_GRES:-gpu}"                   # --gres=<GW1B_GRES>:N  (gpu, or gpu:a100 ...)   VERIFY
export GW1B_SBATCH_EXTRA="${GW1B_SBATCH_EXTRA:-}"      # any extra sbatch flags, e.g. "--constraint=a100"

# Partitions (names from the public Pegasus docs; A100/L40S/GH200 names must be filled in)   VERIFY
export GW1B_PART_DEBUG="${GW1B_PART_DEBUG:-debug-gpu}"      # interactive/testing, 4 h limit
export GW1B_PART_V100_2="${GW1B_PART_V100_2:-small-gpu}"   # 2 x V100 16GB per node
export GW1B_PART_V100_4="${GW1B_PART_V100_4:-large-gpu}"   # 4 x V100 16GB per node (NVLink)
export GW1B_PART_A100="${GW1B_PART_A100:-}"                 # 8 x A100 80GB per node  <- fill in
export GW1B_PART_L40S="${GW1B_PART_L40S:-}"                 # L40S nodes (expansion)  <- fill in
export GW1B_PART_CPU="${GW1B_PART_CPU:-defq}"               # CPU-only nodes (tokenization, data)
export GW1B_PART_DEBUG_CPU="${GW1B_PART_DEBUG_CPU:-debug-cpu}"

# Defaults used by `gw1b jupyter` / `gw1b run` / `gw1b shell` when no flag is given
export GW1B_DEFAULT_PARTITION="${GW1B_DEFAULT_PARTITION:-$GW1B_PART_DEBUG}"
export GW1B_DEFAULT_GPUS="${GW1B_DEFAULT_GPUS:-1}"
export GW1B_DEFAULT_TIME="${GW1B_DEFAULT_TIME:-4:00:00}"
export GW1B_DEFAULT_CPUS="${GW1B_DEFAULT_CPUS:-8}"
export GW1B_DEFAULT_MEM="${GW1B_DEFAULT_MEM:-48G}"
export GW1B_JUPYTER_TIME="${GW1B_JUPYTER_TIME:-4:00:00}"
export GW1B_MAX_TIME="${GW1B_MAX_TIME:-2-00:00:00}"        # partition wall-time limit for chained jobs VERIFY

# --- login host (used by the laptop-side scripts and the printed tunnel command) ----------------
export GW1B_LOGIN_HOST="${GW1B_LOGIN_HOST:-pegasus.arc.gwu.edu}"

# --- shared caches (keep the 25 GB home quota free) --------------------------------------------
export HF_HOME="${HF_HOME:-$GW1B_SCRATCH/hf_cache}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
export JAX_COMPILATION_CACHE_DIR="${JAX_COMPILATION_CACHE_DIR:-$GW1B_SCRATCH/users/$USER/jax_cache}"
export WANDB_DIR="${WANDB_DIR:-$GW1B_SCRATCH/users/$USER}"
export WANDB_MODE="${WANDB_MODE:-offline}"               # compute nodes may have no internet; sync later
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-/tmp/pycache-$USER}"
