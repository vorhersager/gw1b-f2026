# ============================================================================
#  GW1B cluster configuration — THE ONE FILE THE INSTRUCTOR EDITS.
#  Sourced by activate.sh, bin/gw1b*, slurm/*.sbatch and env/build_*.sh.
#  Defaults reflect what Pegasus HPC staff told us on 2026-09-29 (docs/CLUSTER_FACTS.md).
#  Lines marked VERIFY are confirmed/overwritten by `gw1b-admin init` + `gw1b-admin discover` (or by hand).
# ============================================================================

# --- where things live ------------------------------------------------------
# Persistent group storage (NOT purged; keep the environment, tokenizer, code, released models here).
# Pegasus: /<SCHOOL>/groups/<group>, e.g. /SEAS/groups/gw1b                                    VERIFY
export GW1B_GROUP="${GW1B_GROUP:-/SEAS/groups/gw1b}"
# Fast scratch: GPFS at /scratch/<group> (Lustre was retired). Purge policy/quota: ask HPC.      VERIFY
export GW1B_SCRATCH="${GW1B_SCRATCH:-/scratch/gw1b-class}"
# This repository (read-only for students)
export GW1B_HOME="${GW1B_HOME:-$GW1B_GROUP/gw1b-f2026}"
# Unix group of the class (all students are members; owns the group dir)                       VERIFY
export GW1B_UNIX_GROUP="${GW1B_UNIX_GROUP:-gw1b-class}"

# --- runtime -----------------------------------------------------------------
export GW1B_ENV_VERSION="2026.09"
export GW1B_RUNTIME="${GW1B_RUNTIME:-auto}"                 # auto | sif | venv
export GW1B_SIF="${GW1B_SIF:-$GW1B_GROUP/sif/gw1b.sif}"     # built by env/build_sif.sh
export GW1B_VENV="${GW1B_VENV:-$GW1B_GROUP/venv}"            # built by env/build_venv.sh (fallback)
export GW1B_APPTAINER_MODULE="${GW1B_APPTAINER_MODULE:-apptainer}"   # Pegasus: `module load apptainer` (1.3.0)
# Pegasus has no fakeroot: the image is built by GitHub Actions (env/Dockerfile) and pulled from this registry
# with `apptainer build gw1b.sif docker://<image>` (no privileges needed). Leave empty to build from env/gw1b.def.
export GW1B_IMAGE="${GW1B_IMAGE:-ghcr.io/vorhersager/gw1b-f2026:$GW1B_ENV_VERSION}"

# --- Slurm ---------------------------------------------------------------------
export GW1B_ACCOUNT="${GW1B_ACCOUNT:-}"               # only if sbatch requires -A (HPC's example did not)  VERIFY
export GW1B_QOS="${GW1B_QOS:-}"                        # leave empty unless HPC staff gave you a QOS
export GW1B_GRES="${GW1B_GRES:-gpu}"                   # jobs request --gres=<GW1B_GRES>:<type>:N
export GW1B_SBATCH_EXTRA="${GW1B_SBATCH_EXTRA:-}"      # any extra sbatch flags

# Partitions (sinfo -s, 2026-09-29): gpu = ALL GPU nodes (7-day limit), cpu = CPU nodes (14-day), nano = 30-min CPU
# test partition, superChip = Grace Hopper GH200 (ARM host: not usable with the x86 image).  No debug-GPU partition.
export GW1B_PART_GPU="${GW1B_PART_GPU:-gpu}"
export GW1B_PART_CPU="${GW1B_PART_CPU:-cpu}"
export GW1B_PART_DEBUG_CPU="${GW1B_PART_DEBUG_CPU:-nano}"
export GW1B_PART_GH200="${GW1B_PART_GH200:-superChip}"

# GPU types = the GRES type in --gres=gpu:<type>:N  (HPC example: --gres=gpu:a100:8). `gw1b-admin discover`
# reads the real names from `sinfo -o %G`; the RTX PRO 6000 Blackwell nodes (96 GB, no NVLink) arrive in October.
export GW1B_GPU_V100="${GW1B_GPU_V100:-v100}"          # 16 nodes x 2 and 22 nodes x 4 (NVLink), 16 GB, no bf16   VERIFY
export GW1B_GPU_A100="${GW1B_GPU_A100:-a100}"          # gpu050, gpu051: 8 x A100-80GB PCIe (NVLink in pairs)
export GW1B_GPU_L40S="${GW1B_GPU_L40S:-l40s}"          # L40S 48 GB                                              VERIFY
export GW1B_GPU_RTX6000="${GW1B_GPU_RTX6000:-}"        # RTX PRO 6000 Blackwell 96 GB (2x4 + 4x2 nodes)  <- fill in when online
export GW1B_GPU_DEFAULT="${GW1B_GPU_DEFAULT:-$GW1B_GPU_V100}"   # what students get without --gpu-type (keeps the A100s free)

# Defaults used by `gw1b jupyter` / `gw1b run` / `gw1b shell` when no flag is given
export GW1B_DEFAULT_PARTITION="${GW1B_DEFAULT_PARTITION:-$GW1B_PART_GPU}"
export GW1B_DEFAULT_GPUS="${GW1B_DEFAULT_GPUS:-1}"
export GW1B_DEFAULT_TIME="${GW1B_DEFAULT_TIME:-4:00:00}"
export GW1B_DEFAULT_CPUS="${GW1B_DEFAULT_CPUS:-8}"
export GW1B_DEFAULT_MEM="${GW1B_DEFAULT_MEM:-48G}"
export GW1B_JUPYTER_TIME="${GW1B_JUPYTER_TIME:-4:00:00}"
export GW1B_MAX_TIME="${GW1B_MAX_TIME:-7-00:00:00}"        # gpu partition wall-time limit (sinfo). Chain 1-2 day jobs anyway.

# --- login host (used by the laptop-side scripts and the printed tunnel command) ----------------
export GW1B_LOGIN_HOST="${GW1B_LOGIN_HOST:-pegasus.arc.gwu.edu}"

# --- network ---------------------------------------------------------------------------------------
export GW1B_COMPUTE_INTERNET="${GW1B_COMPUTE_INTERNET:-yes}"   # HPC: compute nodes download freely -> data jobs run on cpu nodes

# --- shared caches (keep the home quota free) --------------------------------------------------
export HF_HOME="${HF_HOME:-$GW1B_SCRATCH/hf_cache}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
export JAX_COMPILATION_CACHE_DIR="${JAX_COMPILATION_CACHE_DIR:-$GW1B_SCRATCH/users/$USER/jax_cache}"
export WANDB_DIR="${WANDB_DIR:-$GW1B_SCRATCH/users/$USER}"
export WANDB_MODE="${WANDB_MODE:-offline}"               # compute nodes have internet: set WANDB_MODE=online + WANDB_API_KEY for live dashboards
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-$GW1B_SCRATCH/tmp/apptainer-cache-$USER}"
export APPTAINER_TMPDIR="${APPTAINER_TMPDIR:-$GW1B_SCRATCH/tmp/apptainer-tmp-$USER}"
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-/tmp/pycache-$USER}"
